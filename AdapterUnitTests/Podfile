# To download all the dependencies:
# pod install
#
# To download adapters selectively:
# export ADAPTER_TARGETS="TargetName1,TargetName2"
# pod install

require 'json'

project 'AdapterUnitTests.xcodeproj'

use_frameworks!
workspace 'AdapterUnitTests'

ADAPTER_PODSPECS = Dir.glob(File.expand_path('../adapters/**/CocoaPods/*.podspec.json', __dir__)).each_with_object({}) do |path, map|
  adapter_dir_name = File.basename(File.expand_path('../../', path))
  map[adapter_dir_name] = path
end.freeze

def podspec_ios_version(podspec_rel_path)
  return nil if podspec_rel_path.nil? || podspec_rel_path.strip.empty?
  podspec_path = File.expand_path(podspec_rel_path, __dir__)
  return nil unless File.exist?(podspec_path)

  spec = JSON.parse(File.read(podspec_path))
  spec.dig('platforms', 'ios')&.to_s
rescue StandardError => e
  Pod::UI.warn "Failed to parse #{podspec_rel_path}: #{e.message}" if defined?(Pod::UI)
  nil
end

adapter_targets = ENV['ADAPTER_TARGETS']&.split(',')&.map(&:strip)&.reject(&:empty?) || []

target_podspecs = if adapter_targets.any?
  adapter_targets.map { |t| ADAPTER_PODSPECS[t] }.compact
else
  ADAPTER_PODSPECS.values
end

versions = target_podspecs.map { |path| podspec_ios_version(path) }.compact

target_ios_version = versions.select { |v| Gem::Version.correct?(v.to_s) }.max_by do |v|
  Gem::Version.new(v.to_s)
end || '13.0'

platform :ios, target_ios_version

install! 'cocoapods', :deterministic_uuids => false

