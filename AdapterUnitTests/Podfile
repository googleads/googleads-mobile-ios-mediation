# To download all the dependencies:
# pod install
#
# To download adapters selectively:
# export ADAPTER_TARGETS="TargetName1,TargetName2"
# pod install

require 'json'

project 'AdapterUnitTests.xcodeproj'

use_frameworks!
workspace 'AdapterUnitTests'

ADAPTER_PROJECTS = Dir.glob(File.expand_path('../adapters/**/*.xcodeproj', __dir__)).each_with_object({}) do |xcodeproj_path, map|
  next if xcodeproj_path.include?('/NewAdapterSkeleton/') || xcodeproj_path.include?('/CommonAdapter/')

  adapter_name = File.basename(xcodeproj_path, '.xcodeproj')
  map[adapter_name] = xcodeproj_path
end.freeze

ADAPTER_PODSPECS = Dir.glob(File.expand_path('../adapters/**/CocoaPods/*.podspec.json', __dir__)).each_with_object({}) do |path, map|
  next if path.include?('/NewAdapterSkeleton/')

  adapter_dir = File.expand_path('../../', path)
  xcodeproj_path = Dir.glob(File.join(adapter_dir, '*.xcodeproj')).first
  adapter_name = xcodeproj_path ? File.basename(xcodeproj_path, '.xcodeproj') : File.basename(adapter_dir)
  map[adapter_name] = path
end.freeze

def podspec_ios_version(podspec_rel_path)
  return nil if podspec_rel_path.nil? || podspec_rel_path.strip.empty?
  podspec_path = File.expand_path(podspec_rel_path, __dir__)
  return nil unless File.exist?(podspec_path)

  spec = JSON.parse(File.read(podspec_path))
  spec.dig('platforms', 'ios')&.to_s
rescue StandardError => e
  Pod::UI.warn "Failed to parse #{podspec_rel_path}: #{e.message}" if defined?(Pod::UI)
  nil
end

adapter_targets = ENV['ADAPTER_TARGETS']&.split(',')&.map(&:strip)&.reject(&:empty?) || []

target_podspecs = if adapter_targets.any?
  adapter_targets.map { |t| ADAPTER_PODSPECS[t] }.compact
else
  ADAPTER_PODSPECS.values
end

versions = target_podspecs.map { |path| podspec_ios_version(path) }.compact

target_ios_version = versions.select { |v| Gem::Version.correct?(v.to_s) }.max_by do |v|
  Gem::Version.new(v.to_s)
end || '13.0'

platform :ios, target_ios_version

install! 'cocoapods', :deterministic_uuids => false

abstract_target 'Default' do

  pod 'Google-Mobile-Ads-SDK'

  target 'AdapterUnitTestKit' do
  end

  unit_test_project = Xcodeproj::Project.open(File.expand_path('AdapterUnitTests.xcodeproj', __dir__))
  available_test_targets = unit_test_project.targets.map(&:name)

  ADAPTER_PROJECTS.each do |adapter_name, adapter_proj_path|
    test_target_name = "#{adapter_name}Tests"
    latency_target_name = "#{adapter_name}LatencyTests"
    has_test_target = available_test_targets.include?(test_target_name)
    has_latency_target = available_test_targets.include?(latency_target_name)
    next unless has_test_target || has_latency_target
    next unless adapter_targets.empty? || adapter_targets.include?(adapter_name)

    podspec_path = ADAPTER_PODSPECS[adapter_name]
    if podspec_path
      pod_name = JSON.parse(File.read(podspec_path))['name']
      pod pod_name, :path => podspec_path

      if adapter_proj_path
        adapter_proj = Xcodeproj::Project.open(adapter_proj_path)
        adapter_target_names = adapter_proj.targets.map(&:name)
        static_lib_target = if adapter_target_names.include?('AdapterWithoutValidationScript')
          'AdapterWithoutValidationScript'
        elsif adapter_target_names.include?('Adapter')
          'Adapter'
        end
        if static_lib_target
          target static_lib_target do
            project adapter_proj_path
          end
        end
      end
    end

    if has_test_target
      target test_target_name do
        uses_ocmock = Dir.glob(File.expand_path("#{test_target_name}/**/*.{m,mm,swift,h}", __dir__)).any? do |file|
          File.read(file).include?('OCMock')
        end
        pod 'OCMock' if uses_ocmock
      end
    end

    if has_latency_target
      target latency_target_name do
      end
    end
  end

end

post_install do |installer|
  # Deduplicate multiple platform variants of the same pod target (e.g. Google-Mobile-Ads-SDK-iOS13.0 vs -iOS15.0)
  # to prevent Xcode multiple commands produce / race condition errors during parallel builds.
  grouped = {}
  installer.pods_project.targets.each do |t|
    if t.name =~ /^(.*)-iOS(\d+\.\d+)(.*)$/
      base = $1
      ver = $2
      suffix = $3
      key = "#{base}#{suffix}"
      grouped[key] ||= []
      grouped[key] << { target: t, version: Gem::Version.new(ver), base: base, suffix: suffix }
    end
  end

  grouped.each do |_key, list|
    next if list.size <= 1
    sorted = list.sort_by { |item| item[:version] }
    highest = sorted.last[:target]
    sorted[0...-1].each do |lower|
      lower_target = lower[:target]
      unless lower_target.dependencies.any? { |d| d.target == highest }
        lower_target.add_dependency(highest)
      end
      lower_target.build_phases.each do |bp|
        if bp.isa == 'PBXShellScriptBuildPhase' && bp.name == '[CP] Copy XCFrameworks'
          bp.output_file_list_paths = []
          bp.output_paths = []
          bp.input_file_list_paths = []
          bp.input_paths = []
          bp.shell_script = "echo \"Using XCFramework from #{highest.name}\""
        end
      end
    end
  end
end
