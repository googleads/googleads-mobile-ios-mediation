post_install do |installer|
  # Deduplicate multiple platform variants of the same pod target (e.g. Google-Mobile-Ads-SDK-iOS13.0 vs -iOS15.0)
  # to prevent Xcode multiple commands produce / race condition errors during parallel builds.
  grouped = {}
  installer.pods_project.targets.each do |t|
    if t.name =~ /^(.*)-iOS(\d+\.\d+)(.*)$/
      base = $1
      ver = $2
      suffix = $3
      key = "#{base}#{suffix}"
      grouped[key] ||= []
      grouped[key] << { target: t, version: Gem::Version.new(ver), base: base, suffix: suffix }
    end
  end

  grouped.each do |_key, list|
    next if list.size <= 1
    sorted = list.sort_by { |item| item[:version] }
    highest = sorted.last[:target]
    sorted[0...-1].each do |lower|
      lower_target = lower[:target]
      unless lower_target.dependencies.any? { |d| d.target == highest }
        lower_target.add_dependency(highest)
      end
      lower_target.build_phases.each do |bp|
        if bp.isa == 'PBXShellScriptBuildPhase' && bp.name == '[CP] Copy XCFrameworks'
          bp.output_file_list_paths = []
          bp.output_paths = []
          bp.input_file_list_paths = []
          bp.input_paths = []
          bp.shell_script = "echo \"Using XCFramework from #{highest.name}\""
        end
      end
    end
  end
end
